{
  "name": "tare-pdf-generator",
  "version": "2.2.1",
  "description": "Tare Studio · 图片编排、共享排版与 PDF 导出",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run compile && electron .",
    "dev": "npm run compile && electron . --dev",
    "compile": "node scripts/build.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run compile && node tests/editor.e2e.cjs && node tests/annotations.e2e.cjs && node tests/collection.e2e.cjs",
    "build": "npm run compile && electron-builder",
    "dist": "npm run compile && electron-builder --publish=never"
  },
  "keywords": [
    "electron",
    "pdf",
    "image",
    "generator",
    "design"
  ],
  "author": "GreatpythonGPT",
  "license": "MIT",
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.61.1"
  },
  "dependencies": {
    "konva": "10.9.0",
    "pdf-lib": "1.17.1"
  },
  "build": {
    "appId": "com.tarepdf.generator",
    "productName": "Tare Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/desktop.cjs",
      "app/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Graphics",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    }
  }
}
